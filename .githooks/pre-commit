#!/usr/bin/env bash
# Pre-commit hook: Run make test before allowing commit

# Tests use disposable repositories and linked worktrees. Do not let Git's
# hook environment redirect their commands to the caller's repository/index.
mapfile -t git_local_env < <(git rev-parse --local-env-vars)
unset "${git_local_env[@]}"

echo "Running make test before commit..."
# Parallel by default: targets are independent and take ~35s vs ~5min serial.
export MAKEFLAGS="-j$(nproc) --output-sync=target"
if ! make test; then
  echo ""
  echo "❌ make test failed. Commit aborted."
  echo "Fix the errors above or use 'git commit --no-verify' to bypass."
  exit 1
fi

echo "✅ make test passed. Proceeding with commit."
exit 0
